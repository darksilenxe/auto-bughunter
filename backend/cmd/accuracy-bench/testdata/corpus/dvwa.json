    { "category": "xss", "endpoint": "/vulnerabilities/xss_s/", "parameter": "mtxMessage", "minSeverity": "medium", "description": "Stored XSS in guestbook" },
    { "category": "command injection", "endpoint": "/vulnerabilities/exec/", "parameter": "ip", "minSeverity": "critical" },
    { "category": "path traversal", "endpoint": "/vulnerabilities/fi/", "parameter": "page", "minSeverity": "high" },
    { "category": "csrf", "endpoint": "/vulnerabilities/csrf/", "minSeverity": "medium" }
  ]
}
