#!/bin/sh
# Shim — runs ffuf inside the `ffuf` Docker Compose sidecar.
#
# The backend writes a temporary wordlist to $SHARED_TMP_DIR (mounted as a
# shared docker volume on both backend and ffuf containers) so that the
# `-w <path>` argument resolves correctly inside the sidecar.
exec /usr/local/bin/sidecar-exec ffuf ffuf "$@"
