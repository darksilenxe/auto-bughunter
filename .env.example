# Postgres persistence
DATABASE_URL=postgres://auto:auto@db:5432/autobughunter?sslmode=disable
DB_MAX_OPEN_CONNS=32
DB_MAX_IDLE_CONNS=8
DB_CONN_MAX_LIFETIME=10m
DB_CONN_MAX_IDLE_TIME=2m
DB_OPERATION_TIMEOUT=10s
DB_TRANSIENT_RETRY_COUNT=2
DB_TRANSIENT_RETRY_BACKOFF=200ms
# Bootstrap admin API key used for initial API access. Leave empty only if you
# already provision API keys via persistent storage. Never use a known default.
BOOTSTRAP_ADMIN_API_KEY=

# Optional Neo4j attack-graph persistence (leave NEO4J_URI empty to disable)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=neo4jpass
NEO4J_DATABASE=neo4j

# AI provider — defaults to local Ollama running in Docker (no API key needed).
# Override with an OpenAI-compatible external provider if preferred.
# The provider is auto-detected from the API key prefix and base URL:
#   sk-ant-...  → Anthropic Messages API
#   AIzaSy...   → Google Gemini generateContent API
#   bedrock-runtime URL → AWS Bedrock (uses AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)
#   anything else → OpenAI-compatible (including Ollama)
AI_API_BASE=http://ollama:11434/v1
AI_API_KEY=
AI_MODEL=dolphin-mistral
# Optional larger coding-focused model used for AI orchestration planning.
# Leave empty to use AI_MODEL for all AI calls.
AI_CODING_API_BASE=http://ollama:11434/v1
AI_CODING_API_KEY=
AI_CODING_MODEL=codellama
# Optional small/fast model used for high-frequency low-stakes JSON calls
# (adaptive-probe step decisions, tool-call planning, reflect, command-template
# adaptation). Routes through a dedicated concurrency lane so it can't be
# starved by long-running planner calls on the coding lane. Defaults below
# point at the bundled Ollama sidecar with a small 3B model that handles
# structured JSON well and is cheap to run alongside the primary/coding models.
AI_FAST_API_BASE=http://ollama:11434/v1
AI_FAST_API_KEY=
AI_FAST_MODEL=llama3.2:3b
# Maximum number of LLM requests that may be in flight at once across the whole
# process. All AI-backed agents and the post-scan enrichment phase share one AI
# client, so this caps how hard they collectively hammer the LLM backend. Raise
# it for a high-throughput hosted API; keep it low (1-2) for a single local
# Ollama instance to avoid overloading it. Default: 2.
AI_MAX_CONCURRENT_REQUESTS=2
# Per-lane overrides. Each lane (primary/coding/fast) gets its own semaphore
# so a saturated planner cannot starve high-frequency fast-lane decisions
# (and vice versa). Unset values fall back to AI_MAX_CONCURRENT_REQUESTS, then
# to per-lane defaults (2 for primary/coding, 4 for fast).
AI_MAX_CONCURRENT_REQUESTS_PRIMARY=2
AI_MAX_CONCURRENT_REQUESTS_CODING=2
AI_MAX_CONCURRENT_REQUESTS_FAST=4
# Per-request timeout in seconds for outbound LLM calls. Local Ollama inference
# on CPU-only or memory-constrained Docker containers can take well over 20 s
# for complex security prompts; a too-small value causes every request to time
# out, holding semaphore slots and stalling scans. Default: 120.
AI_REQUEST_TIMEOUT_SECONDS=120
# To use OpenAI instead, uncomment:
# AI_API_BASE=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# To use Anthropic Claude, uncomment:
# AI_API_BASE=https://api.anthropic.com/v1
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-3-5-sonnet-20241022
# To use Google Gemini, uncomment:
# AI_API_BASE=
# AI_API_KEY=AIzaSy...
# AI_MODEL=gemini-1.5-pro
# To use AWS Bedrock (us-east-1 region), uncomment:
# AI_API_BASE=us-east-1
# AI_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
# (also set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN)

# AWS credentials for Bedrock provider (only needed when using Bedrock).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Local Ollama model to pre-pull on container start
OLLAMA_MODEL=dolphin-mistral
# Optional second local Ollama model to pre-pull on container start
OLLAMA_SECONDARY_MODEL=codellama
# Optional small/fast Ollama model to pre-pull on container start, used by the
# AI fast lane (see AI_FAST_MODEL above).
OLLAMA_FAST_MODEL=llama3.2:3b

# Autonomous agent learner service (always-on container)
# HTTPS by default — verified against the cert produced by the `tls-init`
# compose container and trusted via SIDECAR_CA_BUNDLE. Override to http://
# (or unset SIDECAR_CA_BUNDLE) only when running the backend outside the
# compose stack against a plain-HTTP sidecar.
AGENT_LEARNER_URL=https://agents:8091

# Curated security knowledge retrieval sidecar used to enrich summaries and reports.
KNOWLEDGE_SERVICE_URL=https://security-knowledge:8092

# ML scoring sidecar. HTTPS via the same in-cluster CA bundle.
ML_SERVICE_URL=https://ml-service:8090

# HTTP wrapper service URLs for tool sidecars (eliminates Docker socket requirement)
# Set USE_HTTP_TOOL_SERVICES=true to use HTTP wrappers instead of docker compose exec
USE_HTTP_TOOL_SERVICES=true
NUCLEI_SERVICE_URL=https://nuclei-service:8093
ZAP_SERVICE_URL=https://zap-service:8094

# Optional shared-secret used for authenticating backend → sidecar HTTP calls
# (the `agents`, `ml-service`, `security-knowledge`, and `nuclei-service` containers). When set, every request the
# backend sends to those sidecars carries `Authorization: Bearer <token>`,
# and the sidecars reject any request without a matching token (except for
# /health probes). Leave empty to keep the previous open behaviour. Pick a
# long random value, e.g. `openssl rand -hex 32`.
SIDECAR_AUTH_TOKEN=

# Outbound HTTPS guard. On startup the backend validates that every
# env-configured URL for AI providers, sidecars and optional integrations
# (AI_API_BASE, AI_CODING_API_BASE, AI_FAST_API_BASE, KNOWLEDGE_SERVICE_URL,
# AGENT_LEARNER_URL, ML_SERVICE_URL, NUCLEI_SERVICE_URL, ZAP_SERVICE_URL,
# BURP_API_URL, MSF_RPC_URL, CHROME_REMOTE_URL, XSSMAP_OLLAMA_URL) uses
# https:// when pointed at a public host. Plain http:// is permitted only
# for loopback, RFC1918 IPs, and single-label docker-compose service names
# (e.g. `http://ollama:11434`). Set this to `true` to bypass the guard —
# only do so if another layer (e.g. a service mesh) provides encryption.
# Scanner→target traffic is NOT affected by this setting.
ALLOW_INSECURE_OUTBOUND_URLS=false

# ML service inference/training controls.
# ML_SCORING_MODE:
#   blend     -> blend ONNX + heuristic scores (default)
#   shadow    -> serve deterministic heuristic results but log ONNX-vs-heuristic deltas
#   heuristic -> force deterministic scoring only even when a model is present
ML_MODEL_PATH=/models/risk.onnx
ML_SCORING_MODE=blend

# Optional defaults for offline/scheduled training runs (used by
# ml-service/app/training_pipeline.py and .github/workflows/ml-training.yml).
TRAINING_API_BASE=http://localhost:8080
TRAINING_API_KEY=
TRAINING_LIMIT=500
TRAINING_MIN_RECORDS=20
TRAINING_MIN_LABELS=100

# Optional integration feature flags
# Note: Nuclei, ZAP Baseline, and XSSMap execution is controlled per scan via
# console options (`useNucleiIntegration`, `useZapBaselineIntegration`,
# `useXssMapIntegration`) instead of env flags. XSSMap additionally requires
# ALLOW_DESTRUCTIVE_CHECKS=true because it actively sends XSS payloads.
# Optional Metasploit RPC integration (native probes still run when unset)
MSF_RPC_URL=
MSF_RPC_PASSWORD=
# Enables additional high-risk exploit modules in the RPC phase.
MSF_RPC_ENABLE_LESS_SAFE_MODULES=false
# Optional JSON template file for your custom RPC modules.
MSF_RPC_MODULE_TEMPLATE_FILE=
# Tool binary names — these are looked up on $PATH inside the backend
# container. The default values resolve to the shim scripts under
# /usr/local/bin (see backend/scripts/shims/), which `docker compose exec`
# into the matching tool sidecar (zap, nuclei, …). Override only if you
# want to point at a locally-installed binary instead.
NUCLEI_BINARY=nuclei
ZAP_BASELINE_BINARY=zap-baseline.py
# XSSMap (LLM-assisted XSS scanner) is bundled via the `xssmap` Docker
# Compose sidecar and reuses the local `ollama` service. XSSMap is GATED
# behind ALLOW_DESTRUCTIVE_CHECKS because it actively sends XSS payloads.
XSSMAP_BINARY=xssmap
# Optional XSSMap tuning. XSSMAP_MODEL falls back to OLLAMA_MODEL.
XSSMAP_MODEL=codellama
XSSMAP_MAX_PAYLOADS=
XSSMAP_OLLAMA_URL=http://ollama:11434
XSSMAP_TIMEOUT_SECONDS=600
SUBFINDER_BINARY=subfinder
HTTPX_BINARY=httpx
CLOUDLIST_BINARY=cloudlist
NAABU_BINARY=naabu
DNSX_BINARY=dnsx
SHUFFLEDNS_BINARY=shuffledns
KATANA_BINARY=katana
TLSX_BINARY=tlsx
CDNCHECK_BINARY=cdncheck
ASNMAP_BINARY=asnmap
VULNX_BINARY=vulnx
FFUF_BINARY=ffuf
GOBUSTER_BINARY=gobuster
# Kiterunner — API route brute-forcing using compiled `.kite` or `.txt` route
# wordlists. Enable per-scan or set ENABLE_KITERUNNER_INTEGRATION=true to
# auto-run. Defaults to the `kr` binary.
KITERUNNER_BINARY=kr
# gau — passive historical URL discovery (Wayback/Common Crawl/…). Bundled via
# the `gau` Docker Compose sidecar. Non-destructive. Enable per-scan or set
# ENABLE_GAU_INTEGRATION=true to auto-run.
GAU_BINARY=gau
# Arjun — hidden HTTP parameter discovery. Bundled via the `arjun` sidecar.
# Non-destructive. Enable per-scan or set ENABLE_ARJUN_INTEGRATION=true.
ARJUN_BINARY=arjun
# commix — OS command-injection detection. Bundled via the `commix` sidecar.
# GATED behind ALLOW_DESTRUCTIVE_CHECKS because it actively injects command
# payloads. Enable per-scan or set ENABLE_COMMIX_INTEGRATION=true.
COMMIX_BINARY=commix
# LinkFinder — endpoint discovery from JavaScript. Bundled via the
# `linkfinder` sidecar. Non-destructive. Enable per-scan or set
# ENABLE_LINKFINDER_INTEGRATION=true.
LINKFINDER_BINARY=linkfinder
# retire.js — detects JavaScript libraries with known vulnerabilities. Bundled
# via the `retire` sidecar; scans JS bundles the backend downloads into
# SHARED_TMP_DIR. Non-destructive. Enable per-scan or set
# ENABLE_RETIREJS_INTEGRATION=true.
RETIREJS_BINARY=retire
# TruffleHog — secret detection in downloaded JS bundles. Bundled via the
# `trufflehog` sidecar (reads SHARED_TMP_DIR). Non-destructive. Enable per-scan
# or set ENABLE_TRUFFLEHOG_INTEGRATION=true.
TRUFFLEHOG_BINARY=trufflehog
# Uncover — exposed-host discovery from third-party search engines (Shodan,
# Censys, Fofa, …). Bundled via the `uncover` sidecar; supply provider API keys
# via environment. Non-destructive. Enable per-scan or set
# ENABLE_UNCOVER_INTEGRATION=true.
UNCOVER_BINARY=uncover
# Set to 1 to disable the sidecar shims (e.g. when running the backend
# binary outside Docker Compose). The Go scanner will then report the
# standard `<tool>-binary-missing` finding for the affected integration.
SIDECAR_EXEC_DISABLE=
# Shared scratch directory used to hand temporary files (e.g. wordlists)
# to sidecar containers. Must point at a path that is mounted in both
# the backend and the consumer sidecar at the same location. Compose
# wires this to the `shared_tmp` named volume. Leave unset when running
# the backend binary outside Docker Compose to fall back to os.TempDir().
SHARED_TMP_DIR=/tmp/auto-bughunter-shared
# Path to the JSON report produced by the `tool-updater` sidecar on every
# `docker compose up`. Surfaced via `GET /api/tools/updates`. Leave unset
# (or point at a non-existent path) to disable the endpoint when running
# the backend outside Docker Compose.
TOOL_UPDATES_REPORT_PATH=/var/lib/auto-bughunter/updates/report.json
# Optional GitHub token used by the tool-updater sidecar to lift the
# 60 req/h unauthenticated GitHub API rate limit. Any classic PAT or
# fine-grained token with public-repo read scope works.
GITHUB_TOKEN=
# Set to 1 to skip the corresponding tool-updater step on boot — useful
# for offline / air-gapped environments where GitHub is unreachable.
TOOL_UPDATER_SKIP_NUCLEI=0
TOOL_UPDATER_SKIP_VERSION=0
# Headless Chromium DevTools endpoint used by the chromedp browser checks.
# Defaults to the `chromium` sidecar service in docker-compose.yml. Leave
# unset to fall back to launching a local Chromium (requires the binary
# to be installed inside the backend container).
CHROME_REMOTE_URL=http://chromium:9222
INTEGRATION_TIMEOUT_SECONDS=600
DEFAULT_MAX_RETRIES=1
DEFAULT_BACKOFF_MILLIS=4000
SCAN_TIMEOUT_SECONDS=600
MAX_CONCURRENT_SCANS_PER_TARGET=1
GLOBAL_SCAN_BUDGET=5
PROXY_RETENTION_HOURS=168
# Linux / Kali high-resource preset (optional)
# ------------------------------------------------------------------
# The defaults above are deliberately conservative so the platform runs on
# resource-constrained Docker Desktop VMs (Windows/macOS). On a native Linux
# host such as Kali, Docker can use the host CPU/RAM directly, so you can let
# the platform work harder. Uncomment/raise the values below — and pair them
# with the docker-compose.kali.yml resource override — to make fuller use of
# the host (see the "Kali / Linux performance tuning" section in README.md):
#   AI_MAX_CONCURRENT_REQUESTS=4
#   AI_MAX_CONCURRENT_REQUESTS_PRIMARY=4
#   AI_MAX_CONCURRENT_REQUESTS_CODING=4
#   AI_MAX_CONCURRENT_REQUESTS_FAST=8
#   MAX_CONCURRENT_SCANS_PER_TARGET=2
#   GLOBAL_SCAN_BUDGET=10
# Low-resource fallback (small Kali VM / laptop): keep the defaults above, or
# lower the AI lanes to 1 if a single local Ollama instance is being overloaded.

# Burp-style intercepting proxy. Set ENABLE_PROXY=true to expose the proxy
# listener (default :8081) and the in-browser Proxy / Repeater / Intruder
# tools. PROXY_PUBLIC_HOST is shown in the UI's "Configure your browser"
# instructions; default "localhost" is fine for local docker compose use.
ENABLE_PROXY=true
PROXY_PORT=8081
PROXY_PUBLIC_HOST=localhost
# Optional self-signed CA used to MITM HTTPS CONNECT tunnels so request
# and response bodies are captured (otherwise HTTPS tunnels are passed
# through transparently). Set both file paths and PROXY_CA_AUTOGENERATE=true
# to have the backend generate a fresh CA on first boot. Then download the
# CA via the Proxy page (or GET /api/proxy/ca-certificate) and install it
# in your browser/OS trust store.
PROXY_CA_CERT_FILE=/data/proxy-ca/ca.crt
PROXY_CA_KEY_FILE=/data/proxy-ca/ca.key
PROXY_CA_AUTOGENERATE=true
PROXY_CA_COMMON_NAME=Auto BugHunter Proxy CA
# Route scanner-initiated HTTP traffic through an upstream proxy so probes are
# captured by the bundled MITM proxy (and visible alongside browser traffic in
# the Network Graph), or through an external proxy such as Burp/ZAP.
# Defaults to false; flip to true to enable. SCANNER_PROXY_URL defaults to the
# bundled in-process proxy (http://127.0.0.1:${PROXY_PORT}); only change it to
# point at a different proxy.
#
# SCANNER_PROXY_CA_FILE (PEM) lets the scanner trust a self-signed CA used by
# the upstream proxy for HTTPS interception. Prefer this over
# SCANNER_PROXY_INSECURE_SKIP_VERIFY, which disables TLS verification entirely
# and should only be used in local development.
SCANNER_USE_PROXY=false
SCANNER_PROXY_URL=http://127.0.0.1:8081
SCANNER_PROXY_CA_FILE=/data/proxy-ca/ca.crt
SCANNER_PROXY_INSECURE_SKIP_VERIFY=false
SCAN_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
NOTIFY_MIN_CONFIDENCE=0.9
POLICY_GATE_HIGH_BLOCK=1
POLICY_GATE_MEDIUM_BLOCK=3
# Unattended ROI automation guardrails/scheduler
AUTOMATION_MIN_EXPECTED_ROI_USD=75
AUTOMATION_CAMPAIGN_POLL_SECONDS=30
AUTOMATION_DAILY_SCAN_LIMIT=30
AUTOMATION_DAILY_RUNTIME_LIMIT_MINUTES=240
AUTOMATION_DAILY_PROBE_LIMIT=5000

# Self-hosted OAST (out-of-band callback) service.
# When enabled, the backend exposes a separate HTTP listener that records
# inbound interactions on /<token> and surfaces them via /api/oast/*.
# Scanners use this to detect blind SSRF and similar OOB vulnerabilities.
# OAST_PUBLIC_BASE_URL must be the externally reachable URL for the listener.
ENABLE_OAST=false
OAST_LISTEN_PORT=9000
OAST_PUBLIC_BASE_URL=
OAST_TOKEN_TTL_MINUTES=60
OAST_MAX_BODY_BYTES=4096
OAST_MAX_HITS_PER_TOKEN=25

# External wordlist integration (enabled by default)
ENABLE_SECLISTS_WORDLISTS=true
ENABLE_KITERUNNER_WORDLISTS=true
# Wordlist depth profile: "small" (fast, common lists; default) or "full"
# (large/comprehensive SecLists + PayloadsAllTheThings payload index — heavier
# and slower, recommended only with a vendored checkout).
WORDLIST_PROFILE=small
# Optional path to a vendored/mounted SecLists checkout. When set (or when a
# checkout exists at /usr/share/seclists or /wordlists/seclists), lists are read
# from disk and only missing files fall back to the GitHub raw fetch.
SECLISTS_DIR=

# Autonomous agent orchestration. When enabled (default), an AI planner picks
# which agents run next and may dynamically spawn additional agents based on
# in-flight findings. MAX_ORCHESTRATION_ROUNDS bounds the planning loop.
ENABLE_AUTONOMOUS_ORCHESTRATION=true
MAX_ORCHESTRATION_ROUNDS=10

# Frontend API URL used at build time
VITE_API_BASE=http://localhost:8080
# Frontend API key used for browser calls to /api/*
# Must match BOOTSTRAP_ADMIN_API_KEY (or any API key provisioned in the DB).
# This is a Vite build-time variable — docker compose passes it to the frontend
# build automatically from this file. Change both keys together.
VITE_API_KEY=
# Allowed browser origins for CORS (comma-separated). Defaults to local dev UI.
# Example production value: https://scanner.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cross-scan episodic vector memory (pgvector).
# When enabled, confirmed findings are embedded and stored so the hypothesis
# agent has richer, target-aware context on subsequent scans.
# Requires the pgvector/pgvector:pg16 Postgres image (set in docker-compose).
# VECTOR_MEMORY_DSN defaults to DATABASE_URL when unset.
ENABLE_VECTOR_MEMORY=false
VECTOR_MEMORY_DSN=

# Observability stack (Prometheus + Grafana).
# Start with: docker compose --profile obs up
# Prometheus scrapes /metrics on the backend at 15 s intervals.
# Grafana is pre-provisioned with a dashboard at http://localhost:3002.
# The /metrics endpoint is not gated by auth so Prometheus can scrape freely.
