# Comma-separated hostnames (required). Example: example.com,staging.example.com
ALLOWED_TARGETS=example.com

# Postgres persistence
DATABASE_URL=postgres://auto:auto@db:5432/autobughunter?sslmode=disable

# Optional AI provider (OpenAI-compatible)
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# Optional local AI (with `docker compose --profile ai up --build`)
# AI_API_BASE=http://ollama:11434/v1
# AI_MODEL=llama3.1:8b
# AI_API_KEY=

# Optional integration feature flags
ENABLE_NUCLEI_INTEGRATION=false
ENABLE_ZAP_BASELINE_INTEGRATION=false
NUCLEI_BINARY=nuclei
ZAP_BASELINE_BINARY=zap-baseline.py
SUBFINDER_BINARY=subfinder
HTTPX_BINARY=httpx
NAABU_BINARY=naabu
DNSX_BINARY=dnsx
SHUFFLEDNS_BINARY=shuffledns
KATANA_BINARY=katana
TLSX_BINARY=tlsx
CDNCHECK_BINARY=cdncheck
ASNMAP_BINARY=asnmap
FFUF_BINARY=ffuf
GOBUSTER_BINARY=gobuster
INTEGRATION_TIMEOUT_SECONDS=90
DEFAULT_MAX_RETRIES=1
DEFAULT_BACKOFF_MILLIS=400
MAX_CONCURRENT_SCANS_PER_TARGET=1
GLOBAL_SCAN_BUDGET=5
PROXY_RETENTION_HOURS=168
SCAN_WEBHOOK_URL=
SLACK_WEBHOOK_URL=
NOTIFY_MIN_CONFIDENCE=0.9
POLICY_GATE_HIGH_BLOCK=1
POLICY_GATE_MEDIUM_BLOCK=3

# External wordlist integration (enabled by default)
ENABLE_SECLISTS_WORDLISTS=true
ENABLE_KITERUNNER_WORDLISTS=true

# Frontend API URL used at build time
VITE_API_BASE=http://localhost:8080
