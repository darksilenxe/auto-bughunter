# Comma-separated hostnames (required). Example: example.com,staging.example.com
ALLOWED_TARGETS=example.com

# Postgres persistence
DATABASE_URL=postgres://auto:auto@db:5432/autobughunter?sslmode=disable

# Optional AI provider (OpenAI-compatible)
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional integration feature flags
ENABLE_NUCLEI_INTEGRATION=false
ENABLE_ZAP_BASELINE_INTEGRATION=false
ENABLE_SUBFINDER_INTEGRATION=false
ENABLE_HTTPX_INTEGRATION=false
ENABLE_NAABU_INTEGRATION=false
ENABLE_DNSX_INTEGRATION=false
ENABLE_SHUFFLEDNS_INTEGRATION=false
ENABLE_CERTIFICATE_TRANSPARENCY_INTEGRATION=false
ENABLE_AMASS_INTEGRATION=false
ENABLE_KATANA_INTEGRATION=false
ENABLE_TLSX_INTEGRATION=false
ENABLE_CDNCHECK_INTEGRATION=false
ENABLE_ASNMAP_INTEGRATION=false
# Native Go WPScan — no binary required; also auto-triggers when WordPress is detected
ENABLE_WPSCAN_INTEGRATION=false
ENABLE_NIKTO_INTEGRATION=false
# Native Go SQLMap — error-based, boolean-blind, time-based blind; no binary required
ENABLE_SQLMAP_INTEGRATION=false
ENABLE_FFUF_INTEGRATION=false
ENABLE_GOBUSTER_INTEGRATION=false
# Safety control: keep false unless your authorized scope explicitly permits higher-impact checks.
ALLOW_DESTRUCTIVE_CHECKS=false
# HTTP intercepting proxy (Burp Suite-like) — listens on PROXY_PORT when enabled
ENABLE_PROXY=false
PROXY_PORT=8081
NUCLEI_BINARY=nuclei
ZAP_BASELINE_BINARY=zap-baseline.py
SUBFINDER_BINARY=subfinder
HTTPX_BINARY=httpx
NAABU_BINARY=naabu
DNSX_BINARY=dnsx
SHUFFLEDNS_BINARY=shuffledns
KATANA_BINARY=katana
TLSX_BINARY=tlsx
CDNCHECK_BINARY=cdncheck
ASNMAP_BINARY=asnmap
FFUF_BINARY=ffuf
GOBUSTER_BINARY=gobuster
INTEGRATION_TIMEOUT_SECONDS=90

# External wordlist integration (enabled by default)
ENABLE_SECLISTS_WORDLISTS=true
ENABLE_KITERUNNER_WORDLISTS=true

# Frontend API URL used at build time
VITE_API_BASE=http://localhost:8080
