{
  "title": "Auto BugHunter",
  "uid": "auto-bughunter",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Scans Total",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "autobughunter_scans_total", "legendFormat": "scans" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active Scans",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "autobughunter_active_scans", "legendFormat": "active" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Findings Total",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "autobughunter_findings_total", "legendFormat": "findings" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Agent Runs Total",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "autobughunter_agents_total", "legendFormat": "agents" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Scan Rate (per minute)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "expr": "rate(autobughunter_scans_total[1m])", "legendFormat": "scans/min" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Findings Rate by Severity",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "rate(autobughunter_findings_by_severity_total{severity=\"high\"}[5m])", "legendFormat": "high" },
        { "expr": "rate(autobughunter_findings_by_severity_total{severity=\"medium\"}[5m])", "legendFormat": "medium" },
        { "expr": "rate(autobughunter_findings_by_severity_total{severity=\"low\"}[5m])", "legendFormat": "low" },
        { "expr": "rate(autobughunter_findings_by_severity_total{severity=\"info\"}[5m])", "legendFormat": "info" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Scan Duration p50/p95 (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(autobughunter_scan_duration_seconds_bucket[5m]))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(autobughunter_scan_duration_seconds_bucket[5m]))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Agent Runs by Name",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "rate(autobughunter_agent_runs_total[5m])", "legendFormat": "{{agent}}" }
      ]
    }
  ]
}
