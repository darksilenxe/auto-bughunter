# Auto Bughunter env tuned for the OWASP Juice Shop test harness.
# Copy to repo root as `.env` before bringing the stack up:
#
#   cp testing/juice-shop/.env.juiceshop.example .env
#
# Juice Shop is reachable from the backend container as http://juice-shop:3000
# on the shared compose network. The hostname `juice-shop` is what needs to
# appear in ALLOWED_TARGETS.

ALLOWED_TARGETS=juice-shop

# Postgres persistence (matches docker-compose.yml defaults)
DATABASE_URL=postgres://auto:auto@db:5432/autobughunter?sslmode=disable

# Use the bundled Ollama for AI summaries; no external API key required.
AI_API_BASE=http://ollama:11434/v1
AI_API_KEY=
AI_MODEL=phi3:mini
OLLAMA_MODEL=phi3:mini

AGENT_LEARNER_URL=http://agents:8091

# Keep external integrations off for the harness so it runs offline.
ENABLE_NUCLEI_INTEGRATION=false
ENABLE_ZAP_BASELINE_INTEGRATION=false
ENABLE_SHUFFLEDNS_INTEGRATION=false
ENABLE_CERTIFICATE_TRANSPARENCY_INTEGRATION=false
ENABLE_AMASS_INTEGRATION=false
ENABLE_FFUF_INTEGRATION=false
ENABLE_GOBUSTER_INTEGRATION=false
ENABLE_SECLISTS_WORDLISTS=false
ENABLE_KITERUNNER_WORDLISTS=false

INTEGRATION_TIMEOUT_SECONDS=90
DEFAULT_MAX_RETRIES=1
DEFAULT_BACKOFF_MILLIS=400
SCAN_TIMEOUT_SECONDS=900
MAX_CONCURRENT_SCANS_PER_TARGET=1
GLOBAL_SCAN_BUDGET=5
PROXY_RETENTION_HOURS=24

# Out-of-band callback service is in-cluster reachable; safe to enable for
# the harness. The backend will record OOB hits at http://backend:9000/<token>.
ENABLE_OAST=true
OAST_LISTEN_PORT=9000
OAST_PUBLIC_BASE_URL=http://backend:9000
OAST_TOKEN_TTL_MINUTES=60

# Autonomous orchestration on; bounded planning loop.
ENABLE_AUTONOMOUS_ORCHESTRATION=true
MAX_ORCHESTRATION_ROUNDS=10

# Frontend API URL used at build time
VITE_API_BASE=http://localhost:8080
